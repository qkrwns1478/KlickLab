# docker compose 와 앱이 함께 사용하는 DB 포트 (로컬에 PostgreSQL이 이미 5432를 쓰면 5433 등으로 변경)
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:${DB_PORT}/klicklab
DB_USERNAME=klicklab
DB_PASSWORD=klicklab

# HS256 서명 키: 최소 32바이트(256bit) 이상
JWT_SECRET=
JWT_REFRESH_SECRET=

# 신규 가입 계정 자동 승인 여부 (false면 관리자가 users.is_approved 를 true 로 바꿔야 로그인 가능)
AUTH_AUTO_APPROVE=false

# 브라우저에서 API를 호출하는 프론트엔드 주소 (쉼표로 구분). 기본값: Vite 개발 서버(5173)와 8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 집계 스케줄러 (minutes_* / hourly_* / daily_* / weekly_* 테이블) 사용 여부
# AGGREGATION_ENABLED=true
