# 질문 분석 SQL 실행 전용 연결 (klicklab_agent_ro: 화이트리스트 테이블 SELECT + sdk_key RLS)
# 롤은 Flyway V4 가 NOLOGIN 으로 만든다. 로컬에서는 먼저 로그인을 열어 준다.
#   docker exec -it klicklab-postgres psql -U klicklab -d klicklab \
#     -c "ALTER ROLE klicklab_agent_ro LOGIN PASSWORD 'agent_ro'" \
#     -c "ALTER ROLE klicklab_agent LOGIN PASSWORD 'agent'"
DB_HOST=localhost
DB_PORT=5433
DB_NAME=klicklab
DB_RO_USER=klicklab_agent_ro
DB_RO_PASSWORD=agent_ro

# 실행 로그 / 지식 베이스 / RLS 테넌트 토큰 발급 연결 (klicklab_agent)
#  SQL 실행기는 이 연결로 sdk_key 의 토큰을 받아 읽기 전용 세션에 건다 (V5, 사용자가 위조할 수 없는 RLS 기준값)
DB_RW_USER=klicklab_agent
DB_RW_PASSWORD=agent

# Spring 백엔드(backend/.env)와 같은 HS256 시크릿 — 로그인 토큰 검증용
JWT_SECRET=

# 브라우저 CORS 허용 오리진 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (OpenAI 호환 Chat Completions). Phase 2 부터 기본 공급자는 Groq gpt-oss-120b (tool calling)
LLM_PROVIDER=groq

# Groq — 키 발급: https://console.groq.com
#  무료 등급 한도(gpt-oss-120b): RPM 30, RPD 1K, TPM 8K, TPD 200K. 요청 하나가 TPM 을 넘으면 413
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MIN_INTERVAL_SECONDS=2.0

# K-EXAONE 2.5 (LLM_PROVIDER=exaone, Phase 1 단일 턴 비교용) — 키 발급: https://docs.exaone.ai
#  무료 등급 한도: 초당 1회, 하루 100회
EXAONE_API_KEY=
# EXAONE_MODEL=k-exaone_v2.5
# 추론 깊이 (low / high / max). 추론 토큰은 max_tokens 에 포함된다
# LLM_SQL_REASONING_EFFORT=high
# LLM_ANSWER_REASONING_EFFORT=low

# Tool Loop (/agent/runs)
# AGENT_STEP_MAX_TOKENS=3072
# 요청 하나의 입력 토큰 상한 (0 = 제한 없음). 넘으면 이력을 압축하고, 그래도 넘으면 결론을 강제한다
# AGENT_MAX_PROMPT_TOKENS=4800
# AGENT_TOOL_RESULT_ROWS=20

# 지식 베이스 (Phase 3)
#  prompt: 스키마 요약을 시스템 프롬프트에 직접 넣는다 / rag: 질문으로 검색한 문서 + search_knowledge 도구
#  rag 를 쓰려면 먼저 카탈로그를 적재한다: .venv/Scripts/python -m app.knowledge.indexer
# KNOWLEDGE_MODE=prompt
# KNOWLEDGE_CONTEXT_QUOTA=table:2,metric:2,glossary:3,example:1
# KNOWLEDGE_SEARCH_K=4
# 임베딩: local(bge-m3, `uv sync --extra embedding` 필요, 첫 실행 때 약 2.2GB 내려받음) / none(키워드 검색만)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu

ANTHROPIC_API_KEY=
