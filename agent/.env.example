# 질문 분석 SQL 실행 전용 연결 (klicklab_agent_ro: 화이트리스트 테이블 SELECT + sdk_key RLS)
# 롤은 Flyway V4 가 NOLOGIN 으로 만든다. 로컬에서는 먼저 로그인을 열어 준다.
#   docker exec -it klicklab-postgres psql -U klicklab -d klicklab \
#     -c "ALTER ROLE klicklab_agent_ro LOGIN PASSWORD 'agent_ro'" \
#     -c "ALTER ROLE klicklab_agent LOGIN PASSWORD 'agent'"
DB_HOST=localhost
DB_PORT=5433
DB_NAME=klicklab
DB_RO_USER=klicklab_agent_ro
DB_RO_PASSWORD=agent_ro

# 실행 로그 / 지식 베이스 / RLS 테넌트 토큰 발급 연결 (klicklab_agent)
#  SQL 실행기는 이 연결로 sdk_key 의 토큰을 받아 읽기 전용 세션에 건다 (V5, 사용자가 위조할 수 없는 RLS 기준값)
DB_RW_USER=klicklab_agent
DB_RW_PASSWORD=agent

# Spring 백엔드(backend/.env)와 같은 HS256 시크릿 — 로그인 토큰 검증용
JWT_SECRET=

# 브라우저 CORS 허용 오리진 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (OpenAI 호환 Chat Completions). Phase 2 부터 기본 공급자는 Groq gpt-oss-120b (tool calling)
LLM_PROVIDER=groq

# Groq
#  무료 등급 한도(gpt-oss-120b): RPM 30, RPD 1K, TPM 8K, TPD 200K. 요청 하나가 TPM 을 넘으면 413
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MIN_INTERVAL_SECONDS=2.0

# OpenAI (LLM_PROVIDER=openai)
#  Responses API(/v1/responses)로 호출한다. (gpt-6 계열은 Chat Completions 에서 도구와 reasoning_effort 를 함께 쓸 수 없기 때문)
#  프록시를 쓰면 OPENAI_BASE_URL 을 그 주소(…/v1 까지)로 바꾼다.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-6-luna

# K-EXAONE 2.5 (LLM_PROVIDER=exaone, Phase 1 단일 턴 비교용)
#  무료 등급 한도: 초당 1회, 하루 100회
EXAONE_API_KEY=
# EXAONE_MODEL=k-exaone_v2.5
# 추론 깊이 (low / high / max). 추론 토큰은 max_tokens 에 포함된다
# LLM_SQL_REASONING_EFFORT=high
# LLM_ANSWER_REASONING_EFFORT=low

# 로컬 추론 서버 (LLM_PROVIDER=local 또는 LLM_FALLBACK_PROVIDER=local). Ollama 의 OpenAI 호환 API
#  Ollama 기본 num_ctx(4096)를 넘는 입력은 앞부분이 조용히 잘리므로 num_ctx 를 늘린 파생 모델을 만든다:
#    Modelfile:  FROM gpt-oss:20b
#                PARAMETER num_ctx 32768
#    ollama create gpt-oss-20b-ctx32k -f Modelfile
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=gpt-oss-20b-ctx32k
# LOCAL_NUM_CTX=32768
# LOCAL_MAX_CONCURRENCY=1
# 로컬 모델로 진행하는 실행의 시간 한도 배율
# LOCAL_TIME_FACTOR=2.0
# 추론 강도 상한 (gpt-oss-20b 는 high 에서 추론만으로 단계 출력 한도를 다 쓰는 일이 잦다)
# LOCAL_MAX_REASONING_EFFORT=medium

# LLM 폴백: 기본 공급자가 한도 초과(429/413)·장애(5xx, 연결 실패)로 실패하면 로컬 모델로 이어 간다
#  한 실행 도중 넘어가면 그 실행은 끝까지 로컬 모델을 쓴다. 평가(evals)는 기본으로 폴백을 끈다
# LLM_FALLBACK_PROVIDER=none
# LLM_FALLBACK_STATUSES=402,429,413,500,502,503,504
# 폴백이 있을 때 기본 공급자의 retry-after 대기 상한(초)과 재시도 횟수
# LLM_PRIMARY_MAX_WAIT_SECONDS=5
# LLM_PRIMARY_MAX_RETRIES=1
# 실패한 기본 공급자를 건너뛰는 시간 (retry-after 가 있으면 그 값)
# LLM_FALLBACK_COOLDOWN_SECONDS=60
# LLM_FALLBACK_DAILY_COOLDOWN_SECONDS=3600

# Tool Loop (/agent/runs)
# AGENT_STEP_MAX_TOKENS=3072
# 요청 하나의 입력 토큰 상한 (0 = 제한 없음). 넘으면 이력을 압축하고, 그래도 넘으면 결론을 강제한다
# AGENT_MAX_PROMPT_TOKENS=4800
# AGENT_TOOL_RESULT_ROWS=20

# 지식 베이스 (Phase 3)
#  prompt: 스키마 요약을 시스템 프롬프트에 직접 넣는다 / rag: 질문으로 검색한 문서 + search_knowledge 도구
#  rag 를 쓰려면 먼저 카탈로그를 적재한다: .venv/Scripts/python -m app.knowledge.indexer
# KNOWLEDGE_MODE=prompt
# KNOWLEDGE_CONTEXT_QUOTA=table:2,metric:2,glossary:3,example:1
# KNOWLEDGE_SEARCH_K=4
# 고른 지표 문서의 계산 테이블 문서를 최대 이만큼 더 넣는다 (0 = 끔, 검색 평가 기준 1 권장)
# KNOWLEDGE_EXPAND_SOURCES=0
# 임베딩: local(bge-m3, `uv sync --extra embedding` 필요, 첫 실행 때 약 2.2GB 내려받음) / none(키워드 검색만)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu

ANTHROPIC_API_KEY=

# 관측 (Phase 6)
#  Langfuse: HOST 와 키 두 개가 모두 있어야 트레이스를 보낸다. 루트 docker-compose.yml 로 띄운 Langfuse 는
#  http://localhost:3000 이고 기본 키는 아래 값이다. 비워 두면 트레이싱은 꺼진다 (Prometheus 메트릭은 항상 켜짐)
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-klicklab-dev
# LANGFUSE_SECRET_KEY=sk-lf-klicklab-dev
# 트레이스를 환경별로 나눈다. 평가(evals)는 항상 eval 로 보낸다
# LANGFUSE_ENVIRONMENT=development
# GET /metrics (Prometheus). 끄려면 false
# METRICS_ENABLED=true
# 실행 비용(agent_runs.cost_usd, Langfuse 비용) 계산용 단가 덮어쓰기: 모델=입력:출력 (USD / 100만 토큰)
#  기본값은 Groq gpt-oss-120b 공시 가격과 로컬 모델(0). 단가를 모르는 모델의 비용은 비워 둔다
# LLM_PRICES=openai/gpt-oss-120b=0.15:0.60
